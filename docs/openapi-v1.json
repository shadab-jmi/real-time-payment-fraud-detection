  "components": {
    "schemas": {
      "Config": {
        "properties": {
          "scenario": {
            "type": "string",
            "enum": [
              "mixed",
              "showcase"
            ],
            "title": "Scenario"
          },
          "count": {
            "type": "integer",
            "maximum": 720000.0,
            "minimum": 1.0,
            "title": "Count"
          },
          "rate": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Rate"
          }
        },
        "type": "object",
        "required": [
          "scenario",
          "count",
          "rate"
        ],
        "title": "Config"
      },
      "Edit": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "investigating",
              "resolved"
            ],
            "title": "Status"
          },
          "resolution": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolution"
          }
        },
        "type": "object",
        "required": [
          "expected_version",
          "status"
        ],
        "title": "Edit"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Note": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "body": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "id",
          "body"
        ],
        "title": "Note"
      },
      "PaymentRequestV1": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "format": "uuid",
            "title": "Transaction Id"
          },
          "account_id": {
            "type": "string",
            "pattern": "^acct_[A-Za-z0-9_-]{1,59}$",
            "title": "Account Id"
          },
          "merchant_id": {
            "type": "string",
            "pattern": "^mer_[A-Za-z0-9_-]{1,60}$",
            "title": "Merchant Id"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^dev_[A-Za-z0-9_-]{1,60}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "event_time": {
            "type": "string",
            "format": "date-time",
            "title": "Event Time"
          },
          "amount_minor": {
            "type": "integer",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor"
          },
          "currency": {
            "type": "string",
            "const": "INR",
            "title": "Currency"
          },
          "channel": {
            "type": "string",
            "enum": [
              "web",
              "app",
              "pos"
            ],
            "title": "Channel"
          },
          "account_country": {
            "type": "string",
            "title": "Account Country"
          },
          "merchant_country": {
            "type": "string",
            "title": "Merchant Country"
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transaction_id",
          "account_id",
          "merchant_id",
          "event_time",
          "amount_minor",
          "currency",
          "channel",
          "account_country",
          "merchant_country",
          "run_id"
        ],
        "title": "PaymentRequestV1"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBasic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}
